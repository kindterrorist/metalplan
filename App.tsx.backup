                        <div className="absolute top-0 right-0 p-4 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity">
                            <Calendar size={80} className="text-orange-600 dark:text-orange-400 transform -rotate-12 translate-x-4 -translate-y-4" />
                        </div>
                        <div className="relative z-10">
                            <div className="w-12 h-12 bg-orange-50 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-sm dark:shadow-none">
                                <UserPlus size={24} />
                            </div>
                            <div className="text-3xl font-black text-gray-800 dark:text-white mb-1">{monthlyJoiners}</div>
                            <div className="text-sm font-bold text-gray-500 dark:text-gray-400">ورودی ماه جاری</div>
                        </div>
                    </div>
                </div>

                <div className="grid grid-cols-1 xl:grid-cols-3 gap-6 md:gap-8">
                    {/* Main Content Area */}
                    <div className="xl:col-span-2 space-y-6 md:space-y-8">
                        {/* Quick Actions Grid */}
                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                            <button onClick={() => { setSelectedAthlete(null); setEditingAthlete(null); setIsAthleteModalOpen(true); }} className="bg-gradient-to-br from-primary-600 to-primary-700 hover:from-primary-500 hover:to-primary-600 text-white p-4 rounded-3xl shadow-lg shadow-primary-200 dark:shadow-none flex flex-col items-center justify-center gap-2.5 group transition-all active:scale-95 border border-transparent">
                                <div className="bg-white/20 p-2.5 rounded-2xl group-hover:rotate-12 transition-transform"><UserPlus size={26} /></div>
                                <span className="font-bold text-sm">شاگرد جدید</span>
