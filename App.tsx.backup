            const lastDate = new Date(a.measurements[a.measurements.length - 1].date);
            const diffTime = Math.abs(Date.now() - lastDate.getTime());
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays > 30;
