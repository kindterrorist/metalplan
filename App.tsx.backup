                            خلاصه فعالیت‌های باشگاه شما در {new Date().toLocaleDateString('fa-IR', { weekday: 'long', day: 'numeric', month: 'long' })}
                        </p>
                    </div>
                    {trainerProfile?.logoUrl && (
                        <img src={trainerProfile.logoUrl} alt="Logo" className="w-16 h-16 rounded-2xl object-cover shadow-lg border-2 border-white dark:border-dark-700 hover:scale-105 transition-transform" />
                    )}
                </header>

                {/* Stats Grid - Modernized */}
                <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                    <div className="bg-white dark:bg-dark-800 p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-dark-700 relative overflow-hidden group hover:shadow-lg transition-all duration-300">
                        <div className="absolute top-0 right-0 p-4 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity">
                            <Users size={80} className="text-blue-600 dark:text-blue-400 transform -rotate-12 translate-x-4 -translate-y-4" />
                        </div>
                        <div className="relative z-10">
                            <div className="w-12 h-12 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-sm dark:shadow-none">
                                <Users size={24} />
                            </div>
                            <div className="text-3xl font-black text-gray-800 dark:text-white mb-1">{athletes.length}</div>
                            <div className="text-sm font-bold text-gray-500 dark:text-gray-400">کل ورزشکاران</div>
                        </div>
                    </div>

                    <div className="bg-white dark:bg-dark-800 p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-dark-700 relative overflow-hidden group hover:shadow-lg transition-all duration-300">
                        <div className="absolute top-0 right-0 p-4 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity">
                            <FileText size={80} className="text-emerald-600 dark:text-emerald-400 transform -rotate-12 translate-x-4 -translate-y-4" />
                        </div>
                        <div className="relative z-10">
                            <div className="w-12 h-12 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-sm dark:shadow-none">
                                <FileText size={24} />
                            </div>
                            <div className="text-3xl font-black text-gray-800 dark:text-white mb-1">{plans.length}</div>
                            <div className="text-sm font-bold text-gray-500 dark:text-gray-400">برنامه‌های فعال</div>
